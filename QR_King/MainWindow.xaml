<Window x:Class="QR_King.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QR King" Width="480" Height="780" MinWidth="440" MinHeight="680" AllowDrop="True" PreviewDragOver="Content_DragOver" PreviewDrop="Content_Drop"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource SurfaceBrush}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Grid Margin="24" Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="QR King" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Copy text. Your QR code appears here." Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
            <CheckBox x:Name="LiveUpdates" Content="Live updates" IsChecked="True" Margin="0,12,0,0" Checked="LiveUpdates_Changed" Unchecked="LiveUpdates_Changed"/>
            <WrapPanel Margin="0,10,0,0">
                <CheckBox x:Name="FitWindow" Content="Fit window to QR code" Checked="Preferences_Changed" Unchecked="Preferences_Changed" Margin="0,0,16,8"/>
                <CheckBox x:Name="PinWindow" Content="Always on top" Checked="Preferences_Changed" Unchecked="Preferences_Changed" Margin="0,0,0,8"/>
            </WrapPanel>
            <WrapPanel>
                <Button Content="Advanced…" Click="Advanced_Click" Margin="0,0,8,0"/>
                <Button Content="Templates…" Click="Templates_Click" Margin="0,0,8,0"/>
                <Button Content="Clear" Click="Clear_Click"/>
            </WrapPanel>
            <TextBlock Text="Drop a .txt file anywhere to load it in manual mode." FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Image x:Name="QrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="Generated QR code"/>
                <TextBlock x:Name="EmptyHint" Text="Waiting for clipboard text" Foreground="#596273" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border x:Name="StaleOverlay" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" Padding="20" CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Preview is out of date" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="Press Regenerate to use your edited text." Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,12,0,6" LastChildFill="True">
            <Button x:Name="RegenerateButton" DockPanel.Dock="Right" Content="Regenerate" Click="Regenerate_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=LiveUpdates}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock Text="CLIPBOARD CONTENT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox Grid.Row="3" x:Name="ContentText" IsReadOnly="{Binding IsChecked, ElementName=LiveUpdates}" AcceptsReturn="True" TextChanged="ContentText_Changed" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Clipboard content"/>
        <StackPanel Grid.Row="4" Margin="0,10,0,16">
            <TextBlock x:Name="ExportDimensions" Text="Export size: generate a QR code first" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" AutomationProperties.LiveSetting="Assertive"/>
            <TextBlock x:Name="StatusText" Text="Listening for clipboard changes" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
        </StackPanel>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SaveButton" Content="Save image" HorizontalAlignment="Left" Click="SaveImage_Click" IsEnabled="False"/>
            <Button Grid.Column="1" x:Name="CopyButton" Content="Copy image" Margin="8,0" Click="CopyImage_Click" IsEnabled="False"/>
            <Button Grid.Column="2" Content="About" Click="About_Click"/>
        </Grid>
    </Grid>
</Window>
